---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';
import ConversorMonedas from '../components/widgets/ConversorMonedas';
import GraficoDolar from '../components/widgets/GraficoDolar';
import { api, type DolarData } from '../lib/api';
import { DollarSign, TrendingUp, Info, ArrowRight, ShieldCheck, Building2, Store, HelpCircle, ArrowRightLeft, Share2 } from 'lucide-react';

let dolar: DolarData | null = null;
let historico: Array<{ fecha: string; compra: number; venta: number }> = [];
let fuente = 'Fuente no disponible';
let actualizadoEn = '';
let stale = false;
let tipo = '';

try {
  const [resDolar, resHist] = await Promise.allSettled([
    api.getDolarActual(),
    api.getDolarHistorico(
      new Date(Date.now() - 90 * 86400000).toISOString().slice(0, 10),
      new Date().toISOString().slice(0, 10)
    ),
  ]);

  if (resDolar.status === 'fulfilled') {
    dolar = resDolar.value.data;
    fuente = resDolar.value.meta?.fuente ?? fuente;
    actualizadoEn = resDolar.value.meta?.actualizado_en ?? '';
    stale = resDolar.value.meta?.stale ?? false;
    tipo = resDolar.value.meta?.tipo ?? '';
  }
  if (resHist.status === 'fulfilled') historico = resHist.value.data || [];
} catch {
  // Fallback
}

const compra = dolar?.compra ?? null;
const venta = dolar?.venta ?? null;
const fecha = dolar?.fecha ?? 'Sin dato';
const esReferencial = tipo === 'referencial' || (compra !== null && compra === venta);
const spread = compra !== null && venta !== null ? (venta - compra).toFixed(3) : null;

// Tablas precalculadas de conversión (esenciales para Featured Snippets / Posición Cero en Google)
const montosSoles = [10, 20, 50, 100, 200, 500, 1000, 2000, 5000];
const montosDolares = [1, 5, 10, 20, 50, 100, 200, 500, 1000, 5000];

const schemaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': '¿Qué tipo de cambio muestra esta página?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': esReferencial
          ? `La página muestra una tasa referencial USD/PEN de ${fuente}; no representa una oferta de compra o venta de una entidad financiera.`
          : `La página muestra los valores de compra y venta reportados por ${fuente}. Verifica las condiciones vigentes con tu entidad financiera.`,
      },
    },
    {
      '@type': 'Question',
      'name': '¿Por qué puede variar el tipo de cambio?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Las tasas pueden variar según la entidad, el canal, el horario y las condiciones de cada operación. Esta información es referencial.',
      },
    },
  ],
};
---

<Layout
  title="Tipo de Cambio del Dólar en Perú y Conversor USD/PEN"
  description={`Consulta el tipo de cambio USD/PEN de referencia${venta !== null ? `: S/ ${venta.toFixed(3)}` : ''}. Fuente: ${fuente}. Actualización ${stale ? 'desactualizada' : 'referencial'}.`}
  keywords="tipo de cambio dolar peru, cambio soles a dolares, dolar a soles, conversor usd pen, tipo de cambio referencial"
  schema={schemaJsonLd}
>
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Top Leaderboard Ad -->
    <AdBanner slotId="dolar-header-leaderboard" format="leaderboard" className="mb-6" />

    <!-- Breadcrumb & Header Editorial -->
    <nav class="flex items-center gap-2 text-xs text-ink-500 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-carmesi-700 transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-ink-900 font-medium">Cambio Soles a Dólar</span>
    </nav>

    <header class="border-b border-ink-100 pb-6 mb-8">
      <div class="flex flex-wrap items-center gap-2.5 mb-2.5">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold bg-soles-50 text-soles-800 border border-soles-200">
          Fuente: {fuente}
        </span>
        <span class="text-xs text-ink-500 font-tabular">Fecha de cotización: {fecha}</span>
      </div>
      <h1 class="font-heading text-3xl sm:text-4xl text-ink-950 font-black tracking-tight leading-tight">
        Cambio de Soles a Dólar y Dólar a Soles Hoy en Perú
      </h1>
      <p class="text-sm sm:text-base text-ink-600 mt-2 max-w-4xl leading-relaxed">
        Consulta una tasa USD/PEN de referencia y convierte entre soles y dólares. Los valores pueden variar según la entidad y las condiciones de cada operación.
      </p>
    </header>

    <!-- Bloque Superior Integrado: Cotizaciones en Vivo + Conversor Inmediato -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8 items-stretch">
      
      <!-- Lado Izquierdo (7 cols): cotización y fuente -->
      <div class="lg:col-span-7 flex flex-col justify-between gap-4">
        {dolar && venta !== null ? (
          esReferencial ? (
            <article class="bg-white rounded-xl p-6 sm:p-8 border border-ink-100 shadow-clean">
              <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">Tasa referencial USD/PEN</span>
              <div class="font-tabular text-4xl sm:text-5xl font-black text-ink-950 tracking-tight mt-2">S/ {venta.toFixed(3)}</div>
              <p class="text-sm text-ink-600 mt-3">La fuente entrega una tasa de referencia; no es una cotización de compra o venta de una entidad financiera.</p>
            </article>
          ) : (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 flex-1">
              <article class="bg-white rounded-xl p-5 sm:p-6 border border-ink-100 shadow-clean">
                <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">Compra</span>
                <div class="font-tabular text-3xl sm:text-4xl font-black text-ink-950 mt-2">S/ {compra?.toFixed(3) ?? '—'}</div>
                <p class="text-xs text-ink-500 mt-2">Valor reportado por la fuente; puede variar por entidad.</p>
              </article>
              <article class="bg-white rounded-xl p-5 sm:p-6 border border-carmesi-200 shadow-clean">
                <span class="text-xs font-semibold uppercase tracking-wider text-carmesi-700">Venta</span>
                <div class="font-tabular text-3xl sm:text-4xl font-black text-carmesi-700 mt-2">S/ {venta.toFixed(3)}</div>
                <p class="text-xs text-ink-500 mt-2">Valor reportado por la fuente; verifica la tasa antes de operar.</p>
              </article>
            </div>
          )
        ) : (
          <div class="bg-white rounded-xl p-6 border border-ink-100 text-sm text-ink-600" role="status">
            La cotización no está disponible en este momento.
          </div>
        )}

        <p class="text-xs text-ink-500" role="status">
          Fuente: {fuente}{actualizadoEn ? ` · Actualizado: ${new Date(actualizadoEn).toLocaleString('es-PE', { timeZone: 'America/Lima' })}` : ''}{stale ? ' · Dato desactualizado' : ''}
        </p>
      </div>

      <!-- Lado Derecho (5 cols): Conversor Instantáneo (Al lado de los precios) -->
      <div class="lg:col-span-5 flex flex-col">
        {compra !== null && venta !== null ? (
          <ConversorMonedas client:load tasaCompra={compra} tasaVenta={venta} />
        ) : (
          <div class="bg-white rounded-xl border border-ink-100 p-6 text-sm text-ink-600" role="status">
            El conversor estará disponible cuando se recupere la cotización.
          </div>
        )}
      </div>
    </section>

    <!-- Estructura Principal: Columna Principal (8) + Sidebar Publicidad (4) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Columna Principal -->
      <main class="lg:col-span-8 space-y-8">
        
        <!-- Gráfico de Tendencia Histórica del Dólar -->
        <section aria-label="Evolución Histórica del Dólar">
          {compra !== null && venta !== null && historico.length > 1 ? (
            <GraficoDolar
              client:load
              historico={historico}
              tasaCompraActual={compra}
              tasaVentaActual={venta}
              fuente={fuente}
              shareUrl={new URL(Astro.url.pathname, Astro.site).href}
            />
          ) : (
            <p class="bg-white rounded-xl border border-ink-100 p-5 text-sm text-ink-600" role="status">
              No hay suficientes datos históricos para mostrar una tendencia.
            </p>
          )}
        </section>

        <!-- Anuncio In-Feed intermedio de alta conversión -->
        <AdBanner slotId="dolar-infeed-middle" format="infeed" label="Publicidad Patrocinada" />

        <!-- Tablas de Conversión Directa (Imanes SEO para Featured Snippets de Google) -->
        <section class="bg-white rounded-xl border border-ink-100 p-6 sm:p-8 shadow-clean space-y-6">
          <div class="border-b border-ink-100 pb-4">
            <h2 class="font-heading text-xl font-bold text-ink-950">
              Tablas de Conversión Rápida de Soles a Dólar y Dólar a Soles
            </h2>
            <p class="text-xs sm:text-sm text-ink-500 mt-1">
              Equivalencias indicativas calculadas con la tasa disponible de la fuente.
            </p>
          </div>

          {compra !== null && venta !== null ? <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Tabla 1: De Soles a Dólares (Venta) -->
            <div class="border border-ink-100 rounded-xl overflow-hidden">
              <div class="bg-slate-50 px-4 py-3 border-b border-ink-100">
                <h3 class="font-heading font-bold text-xs uppercase tracking-wider text-ink-700">
                  Cambio de Soles a Dólares (PEN a USD)
                </h3>
              </div>
              <table class="w-full text-xs text-left">
                <thead class="bg-slate-50/50 text-ink-400 font-semibold border-b border-ink-100">
                  <tr>
                    <th scope="col" class="py-2.5 px-4 font-medium">Monto en Soles</th>
                    <th scope="col" class="py-2.5 px-4 text-right font-medium">Equivalente en Dólares</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-ink-100 font-tabular">
                  {montosSoles.map((s) => {
                    const usdVal = (s / venta).toFixed(2);
                    return (
                      <tr class="hover:bg-slate-50/60 transition-colors">
                        <td class="py-2 px-4 font-bold text-ink-900">S/ {s.toLocaleString('es-PE')}</td>
                        <td class="py-2 px-4 text-right font-bold text-carmesi-700">${usdVal} USD</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            <!-- Tabla 2: De Dólares a Soles (Compra) -->
            <div class="border border-ink-100 rounded-xl overflow-hidden">
              <div class="bg-slate-50 px-4 py-3 border-b border-ink-100">
                <h3 class="font-heading font-bold text-xs uppercase tracking-wider text-ink-700">
                  Cambio de Dólares a Soles (USD a PEN)
                </h3>
              </div>
              <table class="w-full text-xs text-left">
                <thead class="bg-slate-50/50 text-ink-400 font-semibold border-b border-ink-100">
                  <tr>
                    <th scope="col" class="py-2.5 px-4 font-medium">Monto en Dólares</th>
                    <th scope="col" class="py-2.5 px-4 text-right font-medium">Equivalente en Soles</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-ink-100 font-tabular">
                  {montosDolares.map((d) => {
                    const penVal = (d * compra).toFixed(2);
                    return (
                      <tr class="hover:bg-slate-50/60 transition-colors">
                        <td class="py-2 px-4 font-bold text-ink-900">${d.toLocaleString('es-PE')} USD</td>
                        <td class="py-2 px-4 text-right font-bold text-ink-950">S/ {penVal}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

          </div> : <p class="text-sm text-ink-600" role="status">Las equivalencias aparecerán cuando haya una cotización disponible.</p>}
        </section>

        <!-- Preguntas Frecuentes SEO (Acordeón / Contenido Estructurado) -->
        <section class="bg-white rounded-xl border border-ink-100 p-6 sm:p-8 shadow-clean space-y-6">
          <div class="border-b border-ink-100 pb-4">
            <h2 class="font-heading text-xl font-bold text-ink-950 flex items-center gap-2">
              <HelpCircle class="w-5 h-5 text-carmesi-600" />
              Preguntas Frecuentes sobre el Cambio de Soles a Dólares
            </h2>
          </div>

          <div class="space-y-4 text-xs sm:text-sm text-ink-700 leading-relaxed">
            <article class="p-4 bg-slate-50/80 rounded-lg border border-ink-100">
              <h3 class="font-bold text-ink-950 mb-1">
                ¿A cuánto está el cambio de soles a dólares hoy en Perú?
              </h3>
              <p class="text-xs text-ink-600">
                {venta !== null ? `La tasa referencial actual es S/ ${venta.toFixed(3)} por USD. El valor real puede variar según la entidad y las condiciones de operación.` : 'La tasa no está disponible en este momento.'}
              </p>
            </article>

            <article class="p-4 bg-slate-50/80 rounded-lg border border-ink-100">
              <h3 class="font-bold text-ink-950 mb-1">
                ¿A cuánto compran el dólar en bancos y casas de cambio?
              </h3>
              <p class="text-xs text-ink-600">
                {compra !== null ? `La tasa referencial de compra reportada es S/ ${compra.toFixed(3)} por USD. Consulta las condiciones de tu entidad antes de operar.` : 'La tasa no está disponible en este momento.'}
              </p>
            </article>

            <article class="p-4 bg-slate-50/80 rounded-lg border border-ink-100">
              <h3 class="font-bold text-ink-950 mb-1">
                ¿Dónde conviene cambiar dinero: bancos, fintechs o calle Ocoña?
              </h3>
              <p class="text-xs text-ink-600">
                Las tasas pueden diferir entre bancos, casas de cambio y plataformas digitales. Compara el precio final, las comisiones y las condiciones antes de realizar una operación.
              </p>
            </article>
          </div>
        </section>

      </main>

      <!-- Sidebar Lateral con Publicidad -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- Sticky Half-Page Ad (300x600) -->
        <AdBanner slotId="dolar-sidebar-sticky" format="halfpage" label="Anuncio Destacado" />

        <!-- Enlaces Rápidos Financieros -->
        <div class="bg-white rounded-xl border border-ink-100 p-5 shadow-clean space-y-4">
          <h3 class="font-heading font-bold text-xs uppercase tracking-wider text-slate-500">
            Otras Utilidades Financieras
          </h3>
          <ul class="space-y-2.5 text-sm">
            <li>
              <a href="/calculadora-igv" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Calculadora de IGV (18%)</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
            <li>
              <a href="/consulta-ruc" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Consulta RUC SUNAT</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
            <li>
              <a href="/validador-dni" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Validador de DNI</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
          </ul>
        </div>

        <!-- Banner Ad adicional en sidebar -->
        <AdBanner slotId="dolar-sidebar-square" format="rectangle" label="Publicidad" />

      </aside>

    </div>

    <!-- Bottom Billboard Ad -->
    <AdBanner slotId="dolar-bottom-billboard" format="billboard" className="mt-12" />

  </div>
</Layout>
