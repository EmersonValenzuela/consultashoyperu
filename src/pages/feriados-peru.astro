---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';
import { api, type FeriadoData, type ProximoFeriadoData } from '../lib/api';
import { Calendar, Clock, AlertCircle, ArrowRight, ShieldCheck, HelpCircle } from 'lucide-react';

let feriados: FeriadoData[] = [];
let proximo: ProximoFeriadoData | null = null;
let errorCarga = false;

try {
  const [fList, fNext] = await Promise.allSettled([
    api.getFeriados(),
    api.getProximoFeriado(),
  ]);

  if (fList.status === 'fulfilled' && fList.value?.data) {
    feriados = fList.value.data;
  }
  if (fNext.status === 'fulfilled' && fNext.value?.data) {
    proximo = fNext.value.data;
  }
} catch {
  errorCarga = true;
}

// Fallback preventivo si el backend estuviera inaccesible
if (feriados.length === 0) {
  feriados = [
    { id: 1, fecha: '2026-01-01', nombre: 'Año Nuevo', tipo: 'nacional', irrenunciable: true },
    { id: 2, fecha: '2026-04-02', nombre: 'Jueves Santo', tipo: 'nacional', irrenunciable: true },
    { id: 3, fecha: '2026-04-03', nombre: 'Viernes Santo', tipo: 'nacional', irrenunciable: true },
    { id: 4, fecha: '2026-05-01', nombre: 'Día del Trabajo', tipo: 'nacional', irrenunciable: true },
    { id: 5, fecha: '2026-06-07', nombre: 'Batalla de Arica y Día de la Bandera', tipo: 'nacional', irrenunciable: true },
    { id: 6, fecha: '2026-06-29', nombre: 'San Pedro y San Pablo', tipo: 'nacional', irrenunciable: true },
    { id: 7, fecha: '2026-07-23', nombre: 'Día de la Fuerza Aérea del Perú', tipo: 'nacional', irrenunciable: true },
    { id: 8, fecha: '2026-07-28', nombre: 'Fiestas Patrias', tipo: 'nacional', irrenunciable: true },
    { id: 9, fecha: '2026-07-29', nombre: 'Fiestas Patrias', tipo: 'nacional', irrenunciable: true },
    { id: 10, fecha: '2026-08-06', nombre: 'Batalla de Junín', tipo: 'nacional', irrenunciable: true },
    { id: 11, fecha: '2026-08-30', nombre: 'Santa Rosa de Lima', tipo: 'nacional', irrenunciable: true },
    { id: 12, fecha: '2026-10-08', nombre: 'Combate de Angamos', tipo: 'nacional', irrenunciable: true },
    { id: 13, fecha: '2026-11-01', nombre: 'Día de Todos los Santos', tipo: 'nacional', irrenunciable: true },
    { id: 14, fecha: '2026-12-08', nombre: 'Inmaculada Concepción', tipo: 'nacional', irrenunciable: true },
    { id: 15, fecha: '2026-12-09', nombre: 'Batalla de Ayacucho', tipo: 'nacional', irrenunciable: true },
    { id: 16, fecha: '2026-12-25', nombre: 'Navidad', tipo: 'nacional', irrenunciable: true },
  ];
}

if (!proximo && feriados.length > 0) {
  const hoyStr = new Date().toISOString().split('T')[0];
  const nextOne = feriados.find((f) => f.fecha >= hoyStr) || feriados[0];
  const diffDays = Math.max(0, Math.ceil((new Date(nextOne.fecha + 'T00:00:00').getTime() - new Date().getTime()) / (1000 * 60 * 60 * 24)));
  proximo = {
    fecha: nextOne.fecha,
    nombre: nextOne.nombre,
    tipo: nextOne.tipo,
    dias_faltantes: diffDays,
  };
}

// Separar feriados en primer y segundo semestre para insertar anuncio infeed contextual
const midIndex = Math.ceil(feriados.length / 2);
const primerSemestre = feriados.slice(0, midIndex);
const segundoSemestre = feriados.slice(midIndex);

const mesesNombres = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Set', 'Oct', 'Nov', 'Dic'];
---

<Layout
  title="Calendario de Feriados en Perú 2026 — Días No Laborables y Puentes"
  description="Calendario oficial de feriados nacionales en Perú 2026 según El Peruano. Próximo feriado, fines de semana largos y cálculo de pago por trabajar feriados."
>
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Top Leaderboard Ad -->
    <AdBanner slotId="feriados-header-leaderboard" format="leaderboard" className="mb-6" />

    <!-- Breadcrumb & Header Editorial -->
    <nav class="flex items-center gap-2 text-xs text-ink-500 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-carmesi-700 transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-ink-900 font-medium">Feriados Perú</span>
    </nav>

    <div class="border-b border-ink-100 pb-6 mb-8">
      <div class="flex flex-wrap items-center gap-2.5 mb-2.5">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold bg-carmesi-50 text-carmesi-700 border border-carmesi-200">
          Diario Oficial El Peruano
        </span>
        <span class="text-xs text-ink-500 font-tabular">Año Calendario 2026</span>
      </div>
      <h1 class="font-heading text-3xl sm:text-4xl text-ink-950 font-black tracking-tight leading-tight">
        Feriados y Días No Laborables en el Perú
      </h1>
      <p class="text-sm sm:text-base text-ink-600 mt-2 max-w-3xl leading-relaxed">
        Lista completa de feriados oficiales de alcance nacional, descansos remunerados obligatorios del sector público y privado, y puentes turísticos aprobados para el año 2026.
      </p>
    </div>

    {proximo && (
      <!-- Hero Próximo Feriado Destacado -->
      <section class="bg-gradient-to-br from-ink-900 via-ink-800 to-slate-900 text-white rounded-2xl p-6 sm:p-8 shadow-elevated mb-10 relative overflow-hidden border border-ink-700/50">
        <div class="absolute -right-12 -bottom-12 w-64 h-64 bg-carmesi-600/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
          <div class="space-y-3 max-w-xl">
            <div class="flex items-center gap-2 text-xs font-bold text-soles-400 uppercase tracking-widest">
              <Clock class="w-3.5 h-3.5" />
              <span>Próximo feriado en el calendario nacional</span>
            </div>
            <h2 class="font-heading text-2xl sm:text-4xl font-black tracking-tight text-white leading-tight">
              {proximo.nombre}
            </h2>
            <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm text-slate-300">
              <span class="inline-flex items-center gap-1.5 bg-white/10 px-3 py-1 rounded-full border border-white/15">
                <Calendar class="w-4 h-4 text-soles-400" />
                <time datetime={proximo.fecha}>{proximo.fecha}</time>
              </span>
              <span class="inline-flex items-center gap-1 bg-carmesi-950/80 text-carmesi-200 px-3 py-1 rounded-full border border-carmesi-800/80 capitalize font-medium">
                {proximo.tipo}
              </span>
            </div>
          </div>

          <div class="bg-white/5 border border-white/15 backdrop-blur-sm rounded-xl p-5 text-center flex lg:flex-col items-center justify-between lg:justify-center gap-3 min-w-[200px]">
            <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Faltan</span>
            <div class="font-tabular text-4xl sm:text-5xl font-black text-soles-400 tracking-tight leading-none">
              {proximo.dias_faltantes}
            </div>
            <span class="text-xs text-slate-300 font-medium">
              {proximo.dias_faltantes === 1 ? 'día calendario' : 'días calendario'}
            </span>
          </div>
        </div>
      </section>
    )}

    <!-- Estructura Principal: Columna de Contenido + Sidebar de Publicidad -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Contenido Principal: Feriados 2026 (8 cols) -->
      <main class="lg:col-span-8 space-y-8">
        
        <!-- Bloque Semestre 1 -->
        <section class="bg-white rounded-xl border border-ink-100 shadow-clean overflow-hidden">
          <div class="px-5 py-4 border-b border-ink-100 bg-slate-50/70 flex items-center justify-between">
            <h2 class="font-heading text-base font-bold text-ink-900">
              Primer Semestre (Enero – Junio 2026)
            </h2>
            <span class="text-xs text-ink-500 font-tabular">{primerSemestre.length} feriados</span>
          </div>

          <div class="divide-y divide-ink-100">
            {primerSemestre.map((f) => {
              const [anio, mes, dia] = f.fecha.split('-').map(Number);
              const mesTexto = mesesNombres[mes - 1] || '';
              return (
                <article class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-slate-50/60 transition-colors">
                  <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-lg bg-slate-50 border border-ink-200/80 flex flex-col items-center justify-center flex-shrink-0 text-center font-tabular shadow-sm">
                      <span class="text-[10px] font-bold uppercase tracking-wider text-carmesi-700 leading-none">
                        {mesTexto}
                      </span>
                      <span class="text-xl font-bold text-ink-900 leading-tight mt-0.5">
                        {dia}
                      </span>
                    </div>
                    <div>
                      <h3 class="font-heading font-bold text-ink-900 text-sm sm:text-base leading-snug">
                        {f.nombre}
                      </h3>
                      <div class="flex items-center gap-2 mt-1 text-xs text-ink-500">
                        <span class="capitalize">{f.tipo}</span>
                        <span>•</span>
                        <span class="font-tabular">{f.fecha}</span>
                      </div>
                    </div>
                  </div>

                  <span class={`text-[11px] font-bold px-2.5 py-1 rounded-full whitespace-nowrap ${
                    f.irrenunciable
                      ? 'bg-rose-50 text-rose-800 border border-rose-200'
                      : 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                  }`}>
                    {f.irrenunciable ? 'Descanso obligatorio' : 'Feriado nacional'}
                  </span>
                </article>
              );
            })}
          </div>
        </section>

        <!-- Anuncio In-Feed intermedio de alta visibilidad -->
        <AdBanner slotId="feriados-infeed-mid" format="infeed" label="Publicidad Patrocinada" />

        <!-- Bloque Semestre 2 -->
        <section class="bg-white rounded-xl border border-ink-100 shadow-clean overflow-hidden">
          <div class="px-5 py-4 border-b border-ink-100 bg-slate-50/70 flex items-center justify-between">
            <h2 class="font-heading text-base font-bold text-ink-900">
              Segundo Semestre (Julio – Diciembre 2026)
            </h2>
            <span class="text-xs text-ink-500 font-tabular">{segundoSemestre.length} feriados</span>
          </div>

          <div class="divide-y divide-ink-100">
            {segundoSemestre.map((f) => {
              const [anio, mes, dia] = f.fecha.split('-').map(Number);
              const mesTexto = mesesNombres[mes - 1] || '';
              return (
                <article class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-slate-50/60 transition-colors">
                  <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-lg bg-slate-50 border border-ink-200/80 flex flex-col items-center justify-center flex-shrink-0 text-center font-tabular shadow-sm">
                      <span class="text-[10px] font-bold uppercase tracking-wider text-carmesi-700 leading-none">
                        {mesTexto}
                      </span>
                      <span class="text-xl font-bold text-ink-900 leading-tight mt-0.5">
                        {dia}
                      </span>
                    </div>
                    <div>
                      <h3 class="font-heading font-bold text-ink-900 text-sm sm:text-base leading-snug">
                        {f.nombre}
                      </h3>
                      <div class="flex items-center gap-2 mt-1 text-xs text-ink-500">
                        <span class="capitalize">{f.tipo}</span>
                        <span>•</span>
                        <span class="font-tabular">{f.fecha}</span>
                      </div>
                    </div>
                  </div>

                  <span class={`text-[11px] font-bold px-2.5 py-1 rounded-full whitespace-nowrap ${
                    f.irrenunciable
                      ? 'bg-rose-50 text-rose-800 border border-rose-200'
                      : 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                  }`}>
                    {f.irrenunciable ? 'Descanso obligatorio' : 'Feriado nacional'}
                  </span>
                </article>
              );
            })}
          </div>
        </section>

        <!-- Sección de Información Laboral Legal y Preguntas Frecuentes -->
        <section class="bg-white rounded-xl border border-ink-100 p-6 sm:p-8 space-y-6">
          <h2 class="font-heading text-xl font-bold text-ink-900 flex items-center gap-2">
            <HelpCircle class="w-5 h-5 text-carmesi-600" />
            Normativa Laboral: ¿Cuánto pagan por trabajar en feriado?
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-ink-700 leading-relaxed">
            <div class="p-4 bg-slate-50 rounded-lg border border-ink-100">
              <h3 class="font-bold text-ink-900 mb-1 flex items-center gap-1.5">
                <ShieldCheck class="w-4 h-4 text-emerald-600" />
                Pago triple por feriado laborado
              </h3>
              <p class="text-xs text-ink-600">
                Según el Decreto Legislativo 713, si un colaborador trabaja en un feriado oficial sin descanso sustitutorio posterior, tiene derecho a percibir 3 remuneraciones diarias: la del día habitual, la de la labor efectuada y una sobretasa del 100%.
              </p>
            </div>

            <div class="p-4 bg-slate-50 rounded-lg border border-ink-100">
              <h3 class="font-bold text-ink-900 mb-1 flex items-center gap-1.5">
                <AlertCircle class="w-4 h-4 text-soles-600" />
                Diferencia con "Día No Laborable"
              </h3>
              <p class="text-xs text-ink-600">
                Los días no laborables decretados por el Gobierno son obligatorios para el sector público (recuperables en jornadas posteriores) y opcionales para el sector privado mediante acuerdo entre empleador y trabajador. No generan pago triple.
              </p>
            </div>
          </div>
        </section>

      </main>

      <!-- Sidebar Lateral: Publicidad y Enlaces Relacionados (4 cols) -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- Sticky Banner 300x600 Half-page -->
        <AdBanner slotId="feriados-sidebar-sticky" format="halfpage" label="Anuncio Destacado" />

        <!-- Enlaces Rápidos a Calculadoras -->
        <div class="bg-white rounded-xl border border-ink-100 p-5 shadow-clean space-y-4">
          <h3 class="font-heading font-bold text-sm text-ink-900 uppercase tracking-wider text-slate-500">
            Calculadoras Laborales
          </h3>
          <ul class="space-y-2.5 text-sm">
            <li>
              <a href="/calculadora-gratificacion" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Calculadora de Gratificación</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
            <li>
              <a href="/calculadora-cts" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Calculadora de CTS (Mayo/Nov)</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
            <li>
              <a href="/calculadora-igv" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Calculadora de IGV (18%)</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
          </ul>
        </div>

        <!-- Banner Ad adicional en sidebar -->
        <AdBanner slotId="feriados-sidebar-square" format="rectangle" label="Publicidad" />

      </aside>

    </div>

    <!-- Bottom Billboard Ad -->
    <AdBanner slotId="feriados-bottom-billboard" format="billboard" className="mt-12" />

  </div>
</Layout>
