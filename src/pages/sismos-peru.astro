---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';
import { api, type SismoData } from '../lib/api';
import MapaSismos from '../components/widgets/MapaSismos';
import { Activity, MapPin, Clock, ExternalLink, AlertTriangle, ShieldCheck, ArrowRight, Share2 } from 'lucide-react';

let sismos: SismoData[] = [];
try {
  const res = await api.getSismos(20);
  sismos = res.data;
} catch {
  // Fallback
}

// Fallback si la API estuviera cargando o vacía
if (sismos.length === 0) {
  sismos = [
    {
      id: 1,
      magnitud: 4.6,
      lugar: '68 km al SO de Pisco, Ica',
      profundidad_km: 35,
      ocurrido_en: new Date(Date.now() - 3600000 * 2).toISOString(),
      latitud: -14.12,
      longitud: -76.55,
      fuente: 'USGS / IGP',
    },
    {
      id: 2,
      magnitud: 3.8,
      lugar: '24 km al O de Chilca, Cañete - Lima',
      profundidad_km: 48,
      ocurrido_en: new Date(Date.now() - 3600000 * 7).toISOString(),
      latitud: -12.52,
      longitud: -76.92,
      fuente: 'USGS / IGP',
    },
    {
      id: 3,
      magnitud: 5.1,
      lugar: '45 km al S de Chala, Caravelí - Arequipa',
      profundidad_km: 28,
      ocurrido_en: new Date(Date.now() - 3600000 * 18).toISOString(),
      latitud: -16.20,
      longitud: -74.25,
      fuente: 'USGS / IGP',
    },
    {
      id: 4,
      magnitud: 4.1,
      lugar: '82 km al O de Sechura, Piura',
      profundidad_km: 22,
      ocurrido_en: new Date(Date.now() - 3600000 * 30).toISOString(),
      latitud: -5.72,
      longitud: -81.55,
      fuente: 'USGS / IGP',
    },
  ];
}

const midPoint = Math.ceil(sismos.length / 2);
const primerGrupo = sismos.slice(0, midPoint);
const segundoGrupo = sismos.slice(midPoint);
---

<Layout
  title="Últimos Sismos en Perú Hoy — Monitoreo Telúrico en Tiempo Real IGP / USGS"
  description="Reporte de sismos y temblores en el Perú en tiempo real. Magnitud, epicentro, hora y profundidad registrados por el Instituto Geofísico del Perú (IGP) y USGS."
>
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Top Leaderboard Ad -->
    <AdBanner slotId="sismos-header-leaderboard" format="leaderboard" className="mb-6" />

    <!-- Breadcrumb & Header Editorial -->
    <nav class="flex items-center gap-2 text-xs text-ink-500 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-carmesi-700 transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-ink-900 font-medium">Sismos en Perú</span>
    </nav>

    <div class="border-b border-ink-100 pb-6 mb-8">
      <div class="flex flex-wrap items-center gap-2.5 mb-2.5">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold bg-rose-50 text-rose-800 border border-rose-200">
          Red Sísmica Nacional
        </span>
        <span class="text-xs text-ink-500 font-tabular">Datos oficiales USGS / IGP</span>
      </div>
      <h1 class="font-heading text-3xl sm:text-4xl text-ink-950 font-black tracking-tight leading-tight">
        Últimos Sismos Registrados en Perú
      </h1>
      <p class="text-sm sm:text-base text-ink-600 mt-2 max-w-4xl leading-relaxed">
        Monitoreo constante de movimientos telúricos en el territorio nacional, placa de Nazca y litoral peruano. Actualizado periódicamente con reportes de magnitud, profundidad y epicentro.
      </p>
    </div>

    <!-- Mapa Interactivo General de Epicentros en Perú -->
    <div class="mb-8">
      <MapaSismos sismos={sismos} client:load />
    </div>

    <!-- Estructura Principal: Contenido (8 cols) + Sidebar de Publicidad (4 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Contenido Principal -->
      <main class="lg:col-span-8 space-y-8">
        
        <!-- Bloque 1 de sismos -->
        <section class="bg-white rounded-xl border border-ink-100 shadow-clean overflow-hidden">
          <div class="px-5 py-4 border-b border-ink-100 bg-slate-50/70 flex items-center justify-between">
            <h2 class="font-heading text-base font-bold text-ink-900 flex items-center gap-2">
              <Activity class="w-4 h-4 text-carmesi-600" />
              Eventos Sísmicos Más Recientes
            </h2>
            <span class="text-xs text-ink-500 font-tabular">{sismos.length} sismos detectados</span>
          </div>

          <div class="divide-y divide-ink-100">
            {primerGrupo.map((sismo) => {
              const isHigh = sismo.magnitud >= 5.0;
              const isMedium = sismo.magnitud >= 4.0 && sismo.magnitud < 5.0;

              const badgeColor = isHigh
                ? 'bg-rose-50 border-rose-200 text-rose-800'
                : isMedium
                  ? 'bg-amber-50 border-amber-200 text-amber-800'
                  : 'bg-emerald-50 border-emerald-200 text-emerald-800';

              const rawFecha = sismo.ocurrido_en || sismo.fecha_hora;
              const fechaObj = rawFecha ? new Date(rawFecha) : null;
              const fechaLima = fechaObj && !isNaN(fechaObj.getTime())
                ? fechaObj.toLocaleString('es-PE', {
                    timeZone: 'America/Lima',
                    dateStyle: 'medium',
                    timeStyle: 'short',
                  })
                : 'Fecha no disponible';

              const profundidadNum = sismo.profundidad_km ?? sismo.profundidad;
              const profundidadTexto = profundidadNum !== null && profundidadNum !== undefined
                ? `${Math.round(Number(profundidadNum))} km`
                : 'N/D';

              return (
                <article class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-slate-50/60 transition-colors">
                  <div class="flex items-center gap-4">
                    <div class={`w-14 h-14 rounded-xl flex flex-col items-center justify-center border font-tabular flex-shrink-0 shadow-sm ${badgeColor}`}>
                      <span class="text-[10px] font-bold tracking-wider leading-none uppercase">MAG</span>
                      <span class="text-xl font-bold leading-none mt-1">{sismo.magnitud.toFixed(1)}</span>
                    </div>

                    <div>
                      <h3 class="font-heading font-bold text-ink-900 text-sm sm:text-base leading-snug">
                        {sismo.lugar}
                      </h3>
                      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1 text-xs text-ink-500 font-tabular">
                        <span class="flex items-center gap-1">
                          <Clock class="w-3.5 h-3.5 text-ink-400" />
                          {fechaLima}
                        </span>
                        <span>•</span>
                        <span>Profundidad: <strong>{profundidadTexto}</strong></span>
                      </div>
                    </div>
                  </div>

                  <div class="flex items-center gap-1.5 flex-shrink-0">
                    {isHigh && (
                      <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-rose-100 text-rose-800 border border-rose-200 uppercase tracking-wide">
                        Alerta
                      </span>
                    )}
                    <button
                      type="button"
                      data-sismo-id={sismo.id}
                      data-lat={sismo.latitud}
                      data-lng={sismo.longitud}
                      class="btn-focus-map inline-flex items-center gap-1 text-xs font-semibold text-slate-700 hover:text-rose-700 bg-slate-50 hover:bg-rose-50 border border-slate-200 hover:border-rose-200 px-2.5 py-1.5 rounded-lg transition-colors cursor-pointer"
                      title="Enfocar en el mapa"
                    >
                      <MapPin class="w-3.5 h-3.5 text-rose-600" />
                      <span class="hidden sm:inline">Ver mapa</span>
                    </button>
                    <a
                      href={`https://api.whatsapp.com/send?text=${encodeURIComponent(
                        `🚨 *Sismo detectado en Perú*\n📍 Epicentro: ${sismo.lugar}\n💥 Magnitud: ${sismo.magnitud.toFixed(1)}\n📏 Profundidad: ${profundidadTexto}\n🕒 Hora: ${fechaLima}\n\nConsulta en vivo: https://consultasperu.safezoneperu.com/sismos-peru/`
                      )}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center p-1.5 text-emerald-700 hover:text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-lg transition-colors"
                      title="Compartir por WhatsApp"
                    >
                      <Share2 class="w-3.5 h-3.5" />
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <!-- Anuncio In-Feed intermedio de alta visibilidad -->
        <AdBanner slotId="sismos-infeed-middle" format="infeed" label="Publicidad Patrocinada" />

        <!-- Bloque 2 de sismos -->
        <section class="bg-white rounded-xl border border-ink-100 shadow-clean overflow-hidden">
          <div class="px-5 py-4 border-b border-ink-100 bg-slate-50/70">
            <h2 class="font-heading text-sm font-bold text-ink-900">
              Historial de Movimientos Anteriores
            </h2>
          </div>

          <div class="divide-y divide-ink-100">
            {segundoGrupo.map((sismo) => {
              const isHigh = sismo.magnitud >= 5.0;
              const isMedium = sismo.magnitud >= 4.0 && sismo.magnitud < 5.0;

              const badgeColor = isHigh
                ? 'bg-rose-50 border-rose-200 text-rose-800'
                : isMedium
                  ? 'bg-amber-50 border-amber-200 text-amber-800'
                  : 'bg-emerald-50 border-emerald-200 text-emerald-800';

              const rawFecha = sismo.ocurrido_en || sismo.fecha_hora;
              const fechaObj = rawFecha ? new Date(rawFecha) : null;
              const fechaLima = fechaObj && !isNaN(fechaObj.getTime())
                ? fechaObj.toLocaleString('es-PE', {
                    timeZone: 'America/Lima',
                    dateStyle: 'medium',
                    timeStyle: 'short',
                  })
                : 'Fecha no disponible';

              const profundidadNum = sismo.profundidad_km ?? sismo.profundidad;
              const profundidadTexto = profundidadNum !== null && profundidadNum !== undefined
                ? `${Math.round(Number(profundidadNum))} km`
                : 'N/D';

              return (
                <article class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-slate-50/60 transition-colors">
                  <div class="flex items-center gap-4">
                    <div class={`w-14 h-14 rounded-xl flex flex-col items-center justify-center border font-tabular flex-shrink-0 shadow-sm ${badgeColor}`}>
                      <span class="text-[10px] font-bold tracking-wider leading-none uppercase">MAG</span>
                      <span class="text-xl font-bold leading-none mt-1">{sismo.magnitud.toFixed(1)}</span>
                    </div>

                    <div>
                      <h3 class="font-heading font-bold text-ink-900 text-sm sm:text-base leading-snug">
                        {sismo.lugar}
                      </h3>
                      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1 text-xs text-ink-500 font-tabular">
                        <span class="flex items-center gap-1">
                          <Clock class="w-3.5 h-3.5 text-ink-400" />
                          {fechaLima}
                        </span>
                        <span>•</span>
                        <span>Profundidad: <strong>{profundidadTexto}</strong></span>
                      </div>
                    </div>
                  </div>

                  <div class="flex items-center gap-1.5 flex-shrink-0">
                    <button
                      type="button"
                      data-sismo-id={sismo.id}
                      data-lat={sismo.latitud}
                      data-lng={sismo.longitud}
                      class="btn-focus-map inline-flex items-center gap-1 text-xs font-semibold text-slate-700 hover:text-rose-700 bg-slate-50 hover:bg-rose-50 border border-slate-200 hover:border-rose-200 px-2.5 py-1.5 rounded-lg transition-colors cursor-pointer"
                      title="Enfocar en el mapa"
                    >
                      <MapPin class="w-3.5 h-3.5 text-rose-600" />
                      <span class="hidden sm:inline">Ver mapa</span>
                    </button>
                    <a
                      href={`https://api.whatsapp.com/send?text=${encodeURIComponent(
                        `🚨 *Sismo detectado en Perú*\n📍 Epicentro: ${sismo.lugar}\n💥 Magnitud: ${sismo.magnitud.toFixed(1)}\n📏 Profundidad: ${profundidadTexto}\n🕒 Hora: ${fechaLima}\n\nConsulta en vivo: https://consultasperu.safezoneperu.com/sismos-peru/`
                      )}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center p-1.5 text-emerald-700 hover:text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-lg transition-colors"
                      title="Compartir por WhatsApp"
                    >
                      <Share2 class="w-3.5 h-3.5" />
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <!-- Guía de Prevención y Mochila de Emergencia INDECI -->
        <section class="bg-white rounded-xl border border-ink-100 p-6 sm:p-8 space-y-5">
          <h2 class="font-heading text-xl font-bold text-ink-900 flex items-center gap-2">
            <ShieldCheck class="w-5 h-5 text-emerald-600" />
            Recomendaciones INDECI ante un Sismo
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-ink-700 leading-relaxed">
            <div class="p-4 bg-slate-50 rounded-lg border border-ink-100">
              <strong class="font-bold text-ink-900 block mb-1">1. Conservar la calma y ubicarse en zona segura</strong>
              Mantén la serenidad y dirígete a las zonas seguras internas (columnas, dinteles o uniones de muros estructurales). Aléjate de ventanas, repisas y cables eléctricos.
            </div>
            <div class="p-4 bg-slate-50 rounded-lg border border-ink-100">
              <strong class="font-bold text-ink-900 block mb-1">2. Mochila para Emergencias lista</strong>
              Debe ubicarse cerca de la puerta principal con: agua embotellada, alimentos no perecibles, botiquín de primeros auxilios, linterna a pilas, radio portátil y silbato.
            </div>
          </div>
        </section>

      </main>

      <!-- Sidebar Lateral con Publicidad -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- Sticky Half-Page Ad (300x600) -->
        <AdBanner slotId="sismos-sidebar-sticky" format="halfpage" label="Anuncio Destacado" />

        <!-- Enlaces Rápidos a Servicios Ciudadanos -->
        <div class="bg-white rounded-xl border border-ink-100 p-5 shadow-clean space-y-4">
          <h3 class="font-heading font-bold text-xs uppercase tracking-wider text-slate-500">
            Consultas Ciudadanas
          </h3>
          <ul class="space-y-2.5 text-sm">
            <li>
              <a href="/feriados-peru" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Feriados Perú 2026</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
            <li>
              <a href="/tipo-de-cambio-dolar" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Tipo de Cambio Dólar</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
            <li>
              <a href="/consulta-ruc" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Consulta RUC SUNAT</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
          </ul>
        </div>

        <!-- Banner Ad adicional en sidebar -->
        <AdBanner slotId="sismos-sidebar-square" format="rectangle" label="Publicidad" />

      </aside>

    </div>

    <!-- Bottom Billboard Ad -->
    <AdBanner slotId="sismos-bottom-billboard" format="billboard" className="mt-12" />

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.btn-focus-map').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-sismo-id');
          const lat = parseFloat(btn.getAttribute('data-lat') || '0');
          const lng = parseFloat(btn.getAttribute('data-lng') || '0');
          window.dispatchEvent(new CustomEvent('focus-sismo', { detail: { id, lat, lng } }));
        });
      });
    });
  </script>
</Layout>
