---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';
import CalculadoraSueldoNeto from '../components/calculators/CalculadoraSueldoNeto';
import { ArrowRight, HelpCircle, Wallet, ShieldCheck, CheckCircle2 } from 'lucide-react';
---

<Layout
  title="Calculadora de Sueldo Neto Perú 2026 — Descuentos AFP, ONP y 5ta Categoría"
  description="Calcula tu sueldo líquido a cobrar en Perú. Conoce cuánto te descuentan de AFP Integra, Prima, Profuturo, Habitat u ONP, y la retención del Impuesto a la Renta de 5ta categoría."
>
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Top Leaderboard Ad -->
    <AdBanner slotId="sueldo-header-leaderboard" format="leaderboard" className="mb-6" />

    <!-- Breadcrumb & Header Editorial -->
    <nav class="flex items-center gap-2 text-xs text-ink-500 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-carmesi-700 transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-ink-900 font-medium">Calculadora de Sueldo Neto</span>
    </nav>

    <div class="border-b border-ink-100 pb-6 mb-8">
      <div class="flex flex-wrap items-center gap-2.5 mb-2.5">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
          Planilla / Régimen General D.L. 728
        </span>
        <span class="text-xs text-ink-500 font-tabular">Deducción anual: 7 UIT (S/ 37,450)</span>
      </div>
      <h1 class="font-heading text-3xl sm:text-4xl text-ink-950 font-black tracking-tight leading-tight">
        Calculadora de Sueldo Neto en Perú
      </h1>
      <p class="text-sm sm:text-base text-ink-600 mt-2 max-w-4xl leading-relaxed">
        Descubre exactamente cuánto dinero recibirás en tu cuenta bancaria a fin de mes. Desglose detallado de aportes obligatorios a AFP u ONP y la retención mensual del Impuesto a la Renta de Quinta Categoría de la SUNAT.
      </p>
    </div>

    <!-- Estructura Principal: Calculadora (8 cols) + Sidebar de Publicidad (4 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Contenido Principal -->
      <main class="lg:col-span-8 space-y-8">
        
        <!-- Componente Calculadora React -->
        <CalculadoraSueldoNeto client:load />

        <!-- Anuncio In-Feed intermedio -->
        <AdBanner slotId="sueldo-infeed-middle" format="infeed" label="Publicidad Patrocinada" />

        <!-- Guía Explicativa de Descuentos Laborales -->
        <section class="bg-white rounded-xl border border-ink-100 p-6 sm:p-8 space-y-6">
          <h2 class="font-heading text-xl font-bold text-ink-900 flex items-center gap-2">
            <HelpCircle class="w-5 h-5 text-emerald-600" />
            ¿Qué descuentos se aplican al sueldo bruto en el Perú?
          </h2>

          <div class="space-y-4 text-sm text-ink-700 leading-relaxed">
            <div class="p-4 bg-slate-50 rounded-lg border border-ink-100">
              <strong class="font-bold text-ink-900 block mb-1">1. Aporte Previsional (Jubilación):</strong>
              Todo trabajador en planilla debe estar afiliado obligatoriamente a la <strong>ONP</strong> (descuento único del 13.00%) o a una <strong>AFP</strong> (Integrada por 10% de fondo individual + ~1.70% de seguro de invalidez y sobrevivencia + comisión de la administradora).
            </div>

            <div class="p-4 bg-slate-50 rounded-lg border border-ink-100">
              <strong class="font-bold text-ink-900 block mb-1">2. Impuesto a la Renta de Quinta Categoría (SUNAT):</strong>
              Se aplica a quienes perciben ingresos anuales superiores a 7 UIT. Las primeras 7 UIT (S/ 37,450) están 100% libres de impuestos. Si tu sueldo bruto mensual es menor a aproximadamente S/ 2,640 (incluyendo gratificaciones), no sufres descuento de 5ta categoría.
            </div>

            <div class="p-4 bg-slate-50 rounded-lg border border-ink-100">
              <strong class="font-bold text-ink-900 block mb-1">3. Aporte a EsSalud (Seguro Social):</strong>
              Es del 9% sobre tu remuneración computable, pero <strong>lo paga 100% tu empleador</strong>. Jamás debe descontarse de tu remuneración bruta.
            </div>
          </div>
        </section>

      </main>

      <!-- Sidebar Lateral con Publicidad y Calculadoras Relacionadas -->
      <aside class="lg:col-span-4 space-y-6">
        
        <AdBanner slotId="sueldo-sidebar-sticky" format="halfpage" label="Anuncio Destacado" />

        <div class="bg-white rounded-xl border border-ink-100 p-5 shadow-clean space-y-4">
          <h3 class="font-heading font-bold text-xs uppercase tracking-wider text-slate-500">
            Otras Calculadoras Laborales
          </h3>
          <ul class="space-y-2.5 text-sm">
            <li>
              <a href="/calculadora-gratificacion" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Calculadora de Gratificación</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
            <li>
              <a href="/calculadora-cts" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Calculadora de CTS</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
            <li>
              <a href="/calculadora-cuarta-categoria" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Recibo por Honorarios (4ta)</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
            <li>
              <a href="/calculadora-igv" class="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 border border-transparent hover:border-ink-100 transition-colors group">
                <span class="font-medium text-ink-800 group-hover:text-carmesi-700">Calculadora de IGV</span>
                <ArrowRight class="w-4 h-4 text-ink-400 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </li>
          </ul>
        </div>

        <AdBanner slotId="sueldo-sidebar-square" format="rectangle" label="Publicidad" />

      </aside>

    </div>

    <AdBanner slotId="sueldo-bottom-billboard" format="billboard" className="mt-12" />

  </div>
</Layout>
