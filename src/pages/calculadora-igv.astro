---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';
import CalculadoraIgv from '../components/calculators/CalculadoraIgv';
---

<Layout
  title="Calculadora de IGV Perú (18%) — Sacar Subtotal y Total Online"
  description="Calcula el Impuesto General a las Ventas (IGV 18%) en Perú. Extrae la base imponible o agrégale el impuesto al subtotal de manera instantánea y gratuita."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <div class="text-center mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-3 py-1 rounded-full inline-block mb-3">
        Tributos y Facturación SUNAT
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Calculadora de IGV (18%) en Perú
      </h1>
      <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-xl mx-auto">
        Herramienta en línea para calcular rápidamente el Subtotal, IGV y Total para facturas, boletas y presupuestos.
      </p>
    </div>

    <!-- Espacio Publicitario Top -->
    <AdBanner slotId="igv-top" />

    <!-- Calculadora React -->
    <div class="mb-10">
      <CalculadoraIgv client:load />
    </div>

    <!-- Guía Informativa SEO -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 space-y-6 text-sm text-slate-700 leading-relaxed">
      <h2 class="text-lg font-bold text-slate-900">¿Cómo calcular el IGV en Perú? Fórmulas oficiales</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-5 bg-slate-50 rounded-xl border border-slate-200">
          <h3 class="font-bold text-slate-900 mb-2">1. Agregar IGV al Subtotal (Base)</h3>
          <p class="text-xs text-slate-600 mb-3">Si tienes el precio sin impuestos y deseas conocer el total a cobrar:</p>
          <div class="bg-white p-3 rounded-lg border border-slate-200 font-mono text-xs font-semibold text-blue-600">
            Total = Base × 1.18<br />
            IGV = Base × 0.18
          </div>
        </div>

        <div class="p-5 bg-slate-50 rounded-xl border border-slate-200">
          <h3 class="font-bold text-slate-900 mb-2">2. Desglosar o Quitar el IGV del Total</h3>
          <p class="text-xs text-slate-600 mb-3">Si tienes el precio final facturado y deseas conocer la base imponible:</p>
          <div class="bg-white p-3 rounded-lg border border-slate-200 font-mono text-xs font-semibold text-blue-600">
            Base = Total ÷ 1.18<br />
            IGV = Total - Base
          </div>
        </div>
      </div>

      <div>
        <h3 class="font-bold text-slate-900 mb-1">¿Qué grava el IGV?</h3>
        <p class="text-xs text-slate-600">
          El Impuesto General a las Ventas grava la venta de bienes muebles en el país, la prestación o utilización de servicios, los contratos de construcción, la primera venta de inmuebles que realicen los constructores y la importación de bienes. Se compone de un 16% de IGV más un 2% por el Impuesto de Promoción Municipal (IPM).
        </p>
      </div>
    </div>

    <!-- Espacio Publicitario Bottom -->
    <AdBanner slotId="igv-bottom" />
  </div>
</Layout>
