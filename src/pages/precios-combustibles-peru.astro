<script>
  import { api } from '../lib/api';

  const refreshCombustibles = async () => {
    try {
      const res = await api.getCombustibles();
      const items = res.data || [];
      if (items.length === 0) return;

      const vigEl = document.getElementById('fuel-vigencia');
      if (vigEl && items[0]?.vigencia_desde) {
        vigEl.textContent = `Vigencia referencial: ${items[0].vigencia_desde}`;
      }

      for (const item of items) {
        document.querySelectorAll<HTMLElement>(`[data-fuel-avg="${item.tipo}"]`).forEach((el) => {
          el.textContent = `S/ ${Number(item.precio_promedio).toFixed(2)}`;
        });
        document.querySelectorAll<HTMLElement>(`[data-fuel-min="${item.tipo}"]`).forEach((el) => {
          el.textContent = `S/ ${Number(item.precio_minimo).toFixed(2)}`;
        });
        document.querySelectorAll<HTMLElement>(`[data-fuel-max="${item.tipo}"]`).forEach((el) => {
          el.textContent = `S/ ${Number(item.precio_maximo).toFixed(2)}`;
        });
      }

      window.dispatchEvent(new CustomEvent('combustibles:updated', { detail: items }));
    } catch {
      // Mantiene datos estáticos de respaldo si falla la red
    }
  };

  void refreshCombustibles();
</script>