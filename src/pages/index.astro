---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';
import { api, type DolarData, type ProximoFeriadoData, type SismoData } from '../lib/api';
import { DollarSign, Calendar, Activity, Calculator, Building2, ShieldCheck, ArrowRight, ArrowUpRight } from 'lucide-react';

let dolar: DolarData | null = null;
let proximoFeriado: ProximoFeriadoData | null = null;
let ultimoSismo: SismoData | null = null;

try {
  const [dolarRes, feriadoRes, sismosRes] = await Promise.allSettled([
    api.getDolarActual(),
    api.getProximoFeriado(),
    api.getSismos(1),
  ]);

  if (dolarRes.status === 'fulfilled') dolar = dolarRes.value.data;
  if (feriadoRes.status === 'fulfilled') proximoFeriado = feriadoRes.value.data;
  if (sismosRes.status === 'fulfilled' && sismosRes.value.data.length > 0) ultimoSismo = sismosRes.value.data[0];
} catch {
  // Fallback
}

const compra = dolar?.compra ?? 3.750;
const venta = dolar?.venta ?? 3.785;
const fechaDolar = dolar?.fecha ?? 'Hoy';
const feriadoNombre = proximoFeriado?.nombre ?? 'Próximo Feriado Oficial';
const diasRestantes = proximoFeriado?.dias_faltantes ?? 0;
---

<Layout title="Información y Utilidades de Perú en Tiempo Real">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- Anuncio Superior Leaderboard (970x90 / 728x90) -->
    <AdBanner slotId="home-leaderboard-top" format="leaderboard" />

    <!-- Encabezado Editorial Principal -->
    <div class="mb-8 pt-2">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200/80 pb-5">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-carmesi-600 block mb-1">
            Resumen Diario Oficial
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink-950 tracking-tight">
            Indicadores y utilidades del día en Perú
          </h1>
        </div>
        <div class="text-xs text-ink-500 font-mono flex items-center gap-2">
          <span>Actualización automática en directo</span>
        </div>
      </div>
    </div>

    <!-- Tablero Asimétrico Protagonista (The Daily Pulse Board) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 mb-8">

      <!-- Protagonista: El Dólar Hoy (7 columnas) -->
      <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-8 flex flex-col justify-between shadow-clean">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-soles-600"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-ink-900 font-mono">
                Tipo de Cambio • Dólar Americano (USD / PEN)
              </span>
            </div>
            <span class="text-xs text-slate-400 font-mono">{fechaDolar}</span>
          </div>

          <!-- Bloque de Cotización Compra / Venta -->
          <div class="grid grid-cols-2 gap-4 my-6">
            <div class="p-4 rounded-xl bg-slate-50/80 border border-slate-100">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 block mb-1">
                Compra
              </span>
              <div class="flex items-baseline gap-1">
                <span class="text-xs font-bold text-slate-400">S/</span>
                <span class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink-950 font-mono tracking-tight">
                  {compra.toFixed(3)}
                </span>
              </div>
              <span class="text-[11px] text-slate-400 block mt-1">Precio para venta al banco</span>
            </div>

            <div class="p-4 rounded-xl bg-carmesi-50/40 border border-carmesi-100/70">
              <span class="text-xs font-semibold uppercase tracking-wider text-carmesi-700 block mb-1">
                Venta
              </span>
              <div class="flex items-baseline gap-1">
                <span class="text-xs font-bold text-carmesi-700">S/</span>
                <span class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-carmesi-700 font-mono tracking-tight">
                  {venta.toFixed(3)}
                </span>
              </div>
              <span class="text-[11px] text-slate-400 block mt-1">Precio para compra en banco</span>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs text-ink-500">
            Margen de cotización: <strong class="text-ink-900 font-mono">S/ {(venta - compra).toFixed(3)}</strong>
          </span>
          <a
            href="/tipo-de-cambio-dolar"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-carmesi-600 hover:text-carmesi-700 transition-colors"
          >
            Abrir conversor y gráfico <ArrowUpRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <!-- Columna Lateral: Feriados y Sismos (5 columnas) -->
      <div class="lg:col-span-5 flex flex-col gap-5">

        <!-- Bloque Feriado Próximo -->
        <div class="bg-white rounded-2xl border border-slate-200/90 p-5 sm:p-6 shadow-clean flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-bold uppercase tracking-wider text-purple-700 font-mono flex items-center gap-1.5">
                <Calendar class="w-3.5 h-3.5" /> Próximo Descanso
              </span>
              <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-purple-100 text-purple-800 font-mono">
                Faltan {diasRestantes} días
              </span>
            </div>

            <h3 class="text-lg sm:text-xl font-bold text-ink-950 mb-1 leading-snug">
              {feriadoNombre}
            </h3>
            <p class="text-xs text-slate-500">
              {proximoFeriado?.fecha ? `Fecha oficial: ${proximoFeriado.fecha}` : 'Consulta los fines de semana largos y puentes turísticos de 2026.'}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 mt-3 flex justify-end">
            <a href="/feriados-peru" class="text-xs font-bold text-purple-700 hover:text-purple-800 flex items-center gap-1">
              Ver calendario anual <ArrowRight class="w-3 h-3" />
            </a>
          </div>
        </div>

        <!-- Bloque Último Sismo -->
        <div class="bg-white rounded-2xl border border-slate-200/90 p-5 sm:p-6 shadow-clean flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-bold uppercase tracking-wider text-rose-700 font-mono flex items-center gap-1.5">
                <Activity class="w-3.5 h-3.5" /> Sismicidad Reciente
              </span>
              {ultimoSismo && (
                <span class="text-xs font-extrabold px-2 py-0.5 rounded bg-rose-50 text-rose-700 border border-rose-200 font-mono">
                  M {ultimoSismo.magnitud.toFixed(1)}
                </span>
              )}
            </div>

            <h3 class="text-sm sm:text-base font-bold text-ink-950 mb-1 line-clamp-1">
              {ultimoSismo?.lugar || 'Red Sísmica Nacional'}
            </h3>
            <p class="text-xs text-slate-500 font-mono">
              {ultimoSismo ? `Profundidad: ${ultimoSismo.profundidad_km} km` : 'Monitoreo geofísico continuo en Perú.'}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 mt-3 flex justify-end">
            <a href="/sismos-peru" class="text-xs font-bold text-rose-700 hover:text-rose-800 flex items-center gap-1">
              Ver reporte de temblores <ArrowRight class="w-3 h-3" />
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Anuncio In-Feed / Banner Intermedio -->
    <AdBanner slotId="home-infeed-middle" format="infeed" />

    <!-- Directorio Estructurado de Calculadoras y Consultas -->
    <div class="mt-12">
      <div class="mb-6">
        <h2 class="text-xl sm:text-2xl font-extrabold text-ink-950 tracking-tight">
          Calculadoras y Consultas Rápidas
        </h2>
        <p class="text-xs sm:text-sm text-ink-500 mt-1">
          Herramientas exactas conforme a las normativas laborales y tributarias del Perú.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Calculadora IGV -->
        <a
          href="/calculadora-igv"
          class="bg-white p-6 rounded-2xl border border-slate-200/90 hover:border-carmesi-300 hover:shadow-elevated transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
              <Calculator class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-ink-950 text-base mb-1 group-hover:text-carmesi-600 transition-colors">
              Calculadora de IGV (18%)
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              Agrega el impuesto o desglosa la base imponible y el subtotal para facturación y presupuestos.
            </p>
          </div>
          <span class="text-xs font-bold text-carmesi-600 mt-4 flex items-center gap-1">
            Calcular IGV <ArrowUpRight class="w-3.5 h-3.5" />
          </span>
        </a>

        <!-- Calculadora Gratificación -->
        <a
          href="/calculadora-gratificacion"
          class="bg-white p-6 rounded-2xl border border-slate-200/90 hover:border-carmesi-300 hover:shadow-elevated transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
              <Calculator class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-ink-950 text-base mb-1 group-hover:text-carmesi-600 transition-colors">
              Calculadora de Gratificación
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              Cálculo semestral de Fiestas Patrias y Navidad con bonificación extraordinaria de EsSalud (9%) o EPS (6.75%).
            </p>
          </div>
          <span class="text-xs font-bold text-carmesi-600 mt-4 flex items-center gap-1">
            Calcular Gratificación <ArrowUpRight class="w-3.5 h-3.5" />
          </span>
        </a>

        <!-- Calculadora CTS -->
        <a
          href="/calculadora-cts"
          class="bg-white p-6 rounded-2xl border border-slate-200/90 hover:border-carmesi-300 hover:shadow-elevated transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-700 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
              <Calculator class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-ink-950 text-base mb-1 group-hover:text-carmesi-600 transition-colors">
              Calculadora de CTS
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              Compensación por Tiempo de Servicios de los depósitos bancarios obligatorios de Mayo y Noviembre.
            </p>
          </div>
          <span class="text-xs font-bold text-carmesi-600 mt-4 flex items-center gap-1">
            Calcular CTS <ArrowUpRight class="w-3.5 h-3.5" />
          </span>
        </a>

        <!-- Consulta RUC -->
        <a
          href="/consulta-ruc"
          class="bg-white p-6 rounded-2xl border border-slate-200/90 hover:border-carmesi-300 hover:shadow-elevated transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-700 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
              <Building2 class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-ink-950 text-base mb-1 group-hover:text-carmesi-600 transition-colors">
              Consulta RUC de SUNAT
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              Verificación de empresas y personas con negocio: razón social, estado tributario y condición de habido.
            </p>
          </div>
          <span class="text-xs font-bold text-carmesi-600 mt-4 flex items-center gap-1">
            Consultar Contribuyente <ArrowUpRight class="w-3.5 h-3.5" />
          </span>
        </a>

        <!-- Validador DNI -->
        <a
          href="/validador-dni"
          class="bg-white p-6 rounded-2xl border border-slate-200/90 hover:border-carmesi-300 hover:shadow-elevated transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
              <ShieldCheck class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-ink-950 text-base mb-1 group-hover:text-carmesi-600 transition-colors">
              Validador de Formato DNI
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              Comprueba la sintaxis de 8 dígitos de documentos de identidad peruanos de forma instantánea.
            </p>
          </div>
          <span class="text-xs font-bold text-carmesi-600 mt-4 flex items-center gap-1">
            Validar Documento <ArrowUpRight class="w-3.5 h-3.5" />
          </span>
        </a>

        <!-- Feriados y Calendario -->
        <a
          href="/feriados-peru"
          class="bg-white p-6 rounded-2xl border border-slate-200/90 hover:border-carmesi-300 hover:shadow-elevated transition-all flex flex-col justify-between group"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-700 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
              <Calendar class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-ink-950 text-base mb-1 group-hover:text-carmesi-600 transition-colors">
              Feriados y Días No Laborables
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              Cronograma de días no laborables oficiales para el sector público y privado en el año 2026.
            </p>
          </div>
          <span class="text-xs font-bold text-carmesi-600 mt-4 flex items-center gap-1">
            Ver Calendario 2026 <ArrowUpRight class="w-3.5 h-3.5" />
          </span>
        </a>
      </div>
    </div>

    <!-- Anuncio Pre-Footer / Billboard Inferior -->
    <AdBanner slotId="home-billboard-bottom" format="billboard" />

  </div>
</Layout>
