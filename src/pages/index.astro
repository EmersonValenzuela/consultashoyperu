---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';
import { api, type DolarData, type ProximoFeriadoData, type SismoData } from '../lib/api';
import { DollarSign, Calendar, Activity, Calculator, Building2, ShieldCheck, ArrowRight } from 'lucide-react';

let dolar: DolarData | null = null;
let proximoFeriado: ProximoFeriadoData | null = null;
let ultimoSismo: SismoData | null = null;

try {
  const [dolarRes, feriadoRes, sismosRes] = await Promise.allSettled([
    api.getDolarActual(),
    api.getProximoFeriado(),
    api.getSismos(1),
  ]);

  if (dolarRes.status === 'fulfilled') dolar = dolarRes.value.data;
  if (feriadoRes.status === 'fulfilled') proximoFeriado = feriadoRes.value.data;
  if (sismosRes.status === 'fulfilled' && sismosRes.value.data.length > 0) ultimoSismo = sismosRes.value.data[0];
} catch {
  // Manejo de fallback para compilación SSR/SSG
}

// Valores por defecto referenciales si la API local no está corriendo en build time
const compra = dolar?.compra ?? 3.75;
const venta = dolar?.venta ?? 3.78;
const fechaDolar = dolar?.fecha ?? 'Hoy';
const feriadoNombre = proximoFeriado?.proximo?.nombre ?? 'Próximo Feriado Nacional';
const diasRestantes = proximoFeriado?.dias_restantes ?? 0;
---

<Layout title="Portal Diario de Utilidades e Información de Perú">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Hero / Headline -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Información y utilidades diarias para el <span class="text-blue-600">Perú</span>
      </h1>
      <p class="mt-3 text-base sm:text-lg text-slate-600">
        Tipo de cambio en vivo, últimos sismos del IGP/USGS, feriados oficiales y calculadoras laborales y tributarias.
      </p>
    </div>

    <!-- 3 Tarjetas Principales del Día -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <!-- Tarjeta Dólar -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 hover:border-blue-300 transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-2.5 py-1 rounded-md flex items-center gap-1.5">
              <DollarSign class="w-3.5 h-3.5" /> Dólar Hoy
            </span>
            <span class="text-xs text-slate-400">{fechaDolar}</span>
          </div>
          <div class="grid grid-cols-2 gap-4 py-2 text-center">
            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
              <span class="text-xs text-slate-500 font-medium block mb-0.5">Compra</span>
              <span class="text-2xl font-black text-slate-900">S/ {compra.toFixed(3)}</span>
            </div>
            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
              <span class="text-xs text-slate-500 font-medium block mb-0.5">Venta</span>
              <span class="text-2xl font-black text-blue-600">S/ {venta.toFixed(3)}</span>
            </div>
          </div>
        </div>
        <a href="/tipo-de-cambio-dolar" class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-blue-600 hover:text-blue-700">
          <span>Ver conversor y gráfico</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Tarjeta Feriados -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 hover:border-emerald-300 transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md flex items-center gap-1.5">
              <Calendar class="w-3.5 h-3.5" /> Próximo Feriado
            </span>
            <span class="text-xs font-semibold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">
              Faltan {diasRestantes} días
            </span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-1">{feriadoNombre}</h3>
          <p class="text-xs text-slate-500">
            {proximoFeriado?.proximo?.fecha || 'Consulta el calendario completo de feriados nacionales y días no laborables.'}
          </p>
        </div>
        <a href="/feriados-peru" class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-emerald-600 hover:text-emerald-700">
          <span>Ver calendario 2026</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Tarjeta Sismos -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 hover:border-rose-300 transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-rose-600 bg-rose-50 px-2.5 py-1 rounded-md flex items-center gap-1.5">
              <Activity class="w-3.5 h-3.5" /> Último Sismo
            </span>
            {ultimoSismo && (
              <span class="text-xs font-black text-rose-600 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-100">
                M {ultimoSismo.magnitud}
              </span>
            )}
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-1 line-clamp-1">
            {ultimoSismo?.lugar || 'Monitoreo sísmico en tiempo real'}
          </h3>
          <p class="text-xs text-slate-500">
            {ultimoSismo ? `Profundidad: ${ultimoSismo.profundidad_km} km` : 'Registros sísmicos de territorio peruano.'}
          </p>
        </div>
        <a href="/sismos-peru" class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-rose-600 hover:text-rose-700">
          <span>Ver mapa y lista completa</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <!-- Espacio Publicitario Top -->
    <AdBanner slotId="home-top" />

    <!-- Accesos Directos a Calculadoras y Consultas -->
    <div class="mt-12">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Calculadoras y Consultas</h2>
          <p class="text-xs text-slate-500">Herramientas laborales, tributarias y verificación de documentos</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Calculadora IGV -->
        <a href="/calculadora-igv" class="bg-white p-6 rounded-xl border border-slate-200 hover:border-blue-400 hover:shadow-md transition-all group">
          <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <Calculator class="w-5 h-5" />
          </div>
          <h3 class="font-bold text-slate-900 text-base mb-1 group-hover:text-blue-600 transition-colors">Calculadora de IGV (18%)</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Calcula al instante el subtotal o base imponible a partir del monto total o viceversa.</p>
        </a>

        <!-- Calculadora Gratificación -->
        <a href="/calculadora-gratificacion" class="bg-white p-6 rounded-xl border border-slate-200 hover:border-emerald-400 hover:shadow-md transition-all group">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <Calculator class="w-5 h-5" />
          </div>
          <h3 class="font-bold text-slate-900 text-base mb-1 group-hover:text-emerald-600 transition-colors">Calculadora de Gratificación</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Conoce tu gratificación de Fiestas Patrias o Navidad más la bonificación de EsSalud o EPS.</p>
        </a>

        <!-- Calculadora CTS -->
        <a href="/calculadora-cts" class="bg-white p-6 rounded-xl border border-slate-200 hover:border-indigo-400 hover:shadow-md transition-all group">
          <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <Calculator class="w-5 h-5" />
          </div>
          <h3 class="font-bold text-slate-900 text-base mb-1 group-hover:text-indigo-600 transition-colors">Calculadora de CTS</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Calcula el depósito semestral de Compensación por Tiempo de Servicios de Mayo y Noviembre.</p>
        </a>

        <!-- Consulta RUC -->
        <a href="/consulta-ruc" class="bg-white p-6 rounded-xl border border-slate-200 hover:border-sky-400 hover:shadow-md transition-all group">
          <div class="w-10 h-10 rounded-lg bg-sky-100 text-sky-600 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <Building2 class="w-5 h-5" />
          </div>
          <h3 class="font-bold text-slate-900 text-base mb-1 group-hover:text-sky-600 transition-colors">Consulta RUC SUNAT</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Consulta la razón social, estado activo/inactivo y condición de habido en el padrón de SUNAT.</p>
        </a>

        <!-- Validador DNI -->
        <a href="/validador-dni" class="bg-white p-6 rounded-xl border border-slate-200 hover:border-teal-400 hover:shadow-md transition-all group">
          <div class="w-10 h-10 rounded-lg bg-teal-100 text-teal-600 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <ShieldCheck class="w-5 h-5" />
          </div>
          <h3 class="font-bold text-slate-900 text-base mb-1 group-hover:text-teal-600 transition-colors">Validador de DNI</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Verificación instantánea de formato de 8 dígitos de documentos de identidad de Perú.</p>
        </a>

        <!-- Calendario Feriados -->
        <a href="/feriados-peru" class="bg-white p-6 rounded-xl border border-slate-200 hover:border-purple-400 hover:shadow-md transition-all group">
          <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <Calendar class="w-5 h-5" />
          </div>
          <h3 class="font-bold text-slate-900 text-base mb-1 group-hover:text-purple-600 transition-colors">Calendario de Feriados 2026</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Días no laborables oficiales del sector público y privado con cuenta regresiva.</p>
        </a>
      </div>
    </div>

    <!-- Espacio Publicitario Bottom -->
    <AdBanner slotId="home-bottom" />
  </div>
</Layout>
