---
interface Props {
  slotId: string;
  format?: 'leaderboard' | 'rectangle' | 'infeed' | 'billboard' | 'halfpage';
  label?: string;
  className?: string;
}

const {
  slotId,
  format = 'leaderboard',
  label = 'Publicidad',
  className = '',
} = Astro.props;

const formatClasses = {
  leaderboard: 'ad-leaderboard',
  rectangle: 'ad-rectangle',
  infeed: 'ad-infeed',
  billboard: 'ad-container max-w-5xl min-h-[250px] w-full p-4',
  halfpage: 'ad-sticky-sidebar',
};

const publisherId = 'ca-pub-7516906606472557';
---

<aside
  class={`${formatClasses[format]} ${className}`}
  aria-label={label}
  data-ad-client={publisherId}
  data-ad-slot={slotId}
>
  <div class="ad-label">{label}</div>
  <div class="flex-1 w-full flex items-center justify-center bg-slate-50/60 rounded-lg border border-dashed border-slate-200">
    <!-- Contenedor oficial Google AdSense -->
    <ins
      class="adsbygoogle"
      style="display:block; width:100%; height:100%;"
      data-ad-client={publisherId}
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <div class="text-center p-3">
      <span class="block text-xs font-semibold text-slate-400">Espacio Publicitario Patrocinado</span>
      <span class="text-[11px] text-slate-400 font-mono mt-0.5 block">{slotId}</span>
    </div>
  </div>
</aside>
