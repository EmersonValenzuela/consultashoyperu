---
const currentPath = Astro.url.pathname;

// Formateo de fecha de Lima para la barra superior
const todayLima = new Date().toLocaleDateString('es-PE', {
  timeZone: 'America/Lima',
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const navItems = [
  { href: '/tipo-de-cambio-dolar', label: 'Dólar' },
  { href: '/sismos-peru', label: 'Sismos' },
  { href: '/feriados-peru', label: 'Feriados' },
  { href: '/calculadora-igv', label: 'IGV' },
  { href: '/calculadora-gratificacion', label: 'Gratificación' },
  { href: '/calculadora-cts', label: 'CTS' },
  { href: '/consulta-ruc', label: 'RUC' },
  { href: '/validador-dni', label: 'DNI' },
];
---

<header class="bg-white border-b border-slate-200/90 sticky top-0 z-50">
  <!-- Top ticker / Live date bar -->
  <div class="bg-ink-950 text-slate-300 text-[11px] py-1 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2 capitalize">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span class="text-slate-200 font-medium">{todayLima}</span>
        <span class="text-slate-500 hidden sm:inline">•</span>
        <span class="text-slate-400 hidden sm:inline">Hora oficial de Perú</span>
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <span class="hidden md:inline font-mono">Bases de datos: SUNAT / BCRP / IGP</span>
        <a href="/tipo-de-cambio-dolar" class="text-white hover:text-carmesi-400 transition-colors font-semibold">
          Cotización en vivo
        </a>
      </div>
    </div>
  </div>

  <!-- Main navigation bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-lg bg-carmesi-600 flex items-center justify-center text-white font-extrabold text-lg shadow-sm tracking-tight group-hover:bg-carmesi-700 transition-colors">
          PE
        </div>
        <div>
          <span class="text-xl font-extrabold tracking-tight text-ink-950 block leading-tight">
            Consulta Hoy
          </span>
          <span class="text-[10px] font-bold text-carmesi-600 uppercase tracking-widest block -mt-0.5">
            Portal Diario Perú
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <a
              href={item.href}
              class={`px-3 py-2 text-sm font-semibold transition-all relative ${
                isActive
                  ? 'text-carmesi-600 after:absolute after:bottom-0 after:left-3 after:right-3 after:h-0.5 after:bg-carmesi-600'
                  : 'text-ink-700 hover:text-ink-950 hover:bg-slate-50 rounded-md'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Quick CTA -->
      <div class="flex items-center gap-2">
        <a
          href="/consulta-ruc"
          class="hidden sm:inline-flex items-center justify-center text-xs font-bold px-3.5 py-2 rounded-lg border border-slate-300 text-ink-800 hover:bg-slate-50 transition-colors"
        >
          Consultar RUC
        </a>
        <a
          href="/calculadora-igv"
          class="inline-flex items-center justify-center text-xs font-bold px-3.5 py-2 rounded-lg bg-ink-950 text-white hover:bg-ink-900 transition-colors shadow-clean"
        >
          Calculadoras
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Subnav Horizontal Bar -->
  <div class="lg:hidden border-t border-slate-100 bg-white/95 overflow-x-auto py-2.5 px-4 flex gap-1.5 text-xs whitespace-nowrap scrollbar-none">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`px-3 py-1.5 rounded-md font-semibold transition-colors ${
          currentPath === item.href
            ? 'bg-carmesi-50 text-carmesi-700 border border-carmesi-200'
            : 'text-ink-700 hover:bg-slate-100'
        }`}
      >
        {item.label}
      </a>
    ))}
  </div>
</header>
